<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>

    <UseWPF>True</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>

    <EmitCompilerGeneratedFiles>True</EmitCompilerGeneratedFiles>

    <Title>LaquaiLib.Windows</Title>
    <PackageDescription>Contains functionality specifically for Windows. Adds references to WinForms, WPF and several other assemblies that are Windows-specific.</PackageDescription>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <DocumentationFile>$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CoreAudio" Version="1.40.0" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.10" />

    <ProjectReference Include="$(SolutionDir)multitarget\LaquaiLib\LaquaiLib.csproj" />
  </ItemGroup>
</Project>