<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>LaquaiLib</Title>
    <PackageDescription>Personal library. General purpose.</PackageDescription>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <DocumentationFile>$(AssemblyName).xml</DocumentationFile>

    <EmitCompilerGeneratedFiles>True</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.9" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.9" />
    <PackageReference Include="UnicodeInformation" Version="2.7.1" />

    <Compile Remove="Numerics\Scalar.cs" />
    <None Include="Numerics\Scalar.cs" />
  </ItemGroup>
</Project>
